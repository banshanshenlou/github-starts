{
  "name": "github-stars-manager",
  "description": "GitHub Stars Manager browser extension",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && npm run verify:extension-key",
    "zip:firefox": "wxt zip -b firefox --mv3 && npm run verify:extension-key",
    "verify:build": "node scripts/verify-cross-browser-build.mjs && npm run verify:extension-key",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:extension": "npm run build && npm run verify:extension-key && node scripts/run-extension-check.mjs",
    "verify:extension-key": "node scripts/verify-extension-key.mjs"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "wxt": "^0.20.17"
  }
}
